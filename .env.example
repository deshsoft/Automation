APP_NAME="Social Publisher"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_DISPLAY_TIMEZONE=Asia/Dhaka
# Public contact address shown on the home page and privacy policy
APP_CONTACT_EMAIL=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=social_automation
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAX_UPLOAD_MB=1024
QUEUE_CONNECTION=database
# Must be longer than the longest upload job (900 seconds)
DB_QUEUE_RETRY_AFTER=960

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Social platforms (see README.md for where to get these)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v24.0
# Only for "Facebook Login for Business" apps (see README)
FACEBOOK_CONFIG_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# public, unlisted or private
YOUTUBE_PRIVACY=public
# 25 = News & Politics
YOUTUBE_CATEGORY_ID=25

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Video downloader (yt-dlp). Leave empty to use storage/app/bin or the system PATH.
YTDLP_PATH=
FFMPEG_PATH=
DENO_PATH=
# cookies.txt exported from your browser, only if YouTube/Facebook asks you to sign in
YTDLP_COOKIES=
DOWNLOAD_MAX_MB=2048
DOWNLOAD_KEEP_DAYS=3
